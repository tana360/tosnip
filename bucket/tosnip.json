{
    "version": "1.0.0",
    "description": "Turns a screenshot into a file path you can paste into a terminal.",
    "homepage": "https://tosnip.com",
    "license": "MIT",
    "notes": "Press Win+Shift+S, focus a terminal, then Ctrl+V. ToSnip types a path such as C:\\ToSnip\\abc123.jpg. That file is not uploaded. Uninstall stops the helper and deletes marked pictures in C:\\ToSnip.",
    "url": "https://raw.githubusercontent.com/tana360/tosnip/9d966ef39b5d0c6e083f2f48d09a012a6dc028f3/public/tosnip-paste.ps1",
    "hash": "86466d70655e830481f3d210d2148fbc216c9e9fe839bc8cc45cf65a1bf8a085",
    "pre_uninstall": [
        "Get-CimInstance Win32_Process -Filter \"Name = 'powershell.exe' OR Name = 'pwsh.exe'\" | ForEach-Object {",
        "    $line = $_.CommandLine",
        "    if ($line -and $line.IndexOf('tosnip-paste.ps1') -ge 0 -and $_.ProcessId -ne $PID) {",
        "        Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "Start-Sleep -Milliseconds 600",
        "$startupDir = [Environment]::GetFolderPath('Startup')",
        "foreach ($lnkName in @('ToSnip paste.lnk', 'Spaceur paste.lnk')) {",
        "    $startup = Join-Path $startupDir $lnkName",
        "    if (Test-Path -LiteralPath $startup) { Remove-Item -LiteralPath $startup -Force }",
        "}"
    ],
    "post_install": [
        "$helper = Join-Path $dir 'tosnip-paste.ps1'",
        "if (-not (Test-Path -LiteralPath $helper)) { throw 'ToSnip helper was not downloaded' }",
        "$drive = $env:SystemDrive",
        "if (-not $drive) { $drive = 'C:' }",
        "$store = $drive + '\\ToSnip'",
        "New-Item -ItemType Directory -Force -Path $store | Out-Null",
        "$marker = Join-Path $store 'tosnip.txt'",
        "if (-not (Test-Path -LiteralPath $marker)) { Set-Content -LiteralPath $marker -Value 'tosnip' -Encoding ASCII }",
        "Get-CimInstance Win32_Process -Filter \"Name = 'powershell.exe' OR Name = 'pwsh.exe'\" | ForEach-Object {",
        "    $line = $_.CommandLine",
        "    if ($line -and $line.IndexOf('tosnip-paste.ps1') -ge 0 -and $_.ProcessId -ne $PID) {",
        "        Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "Start-Sleep -Milliseconds 600",
        "$exe = Join-Path $env:WINDIR 'System32\\WindowsPowerShell\\v1.0\\powershell.exe'",
        "$arguments = '-NoProfile -STA -WindowStyle Hidden -ExecutionPolicy Bypass -File \"' + $helper + '\"'",
        "$startup = [Environment]::GetFolderPath('Startup')",
        "$shell = New-Object -ComObject WScript.Shell",
        "$shortcut = $shell.CreateShortcut((Join-Path $startup 'ToSnip paste.lnk'))",
        "$shortcut.TargetPath = $exe",
        "$shortcut.Arguments = $arguments",
        "$shortcut.WorkingDirectory = $dir",
        "$shortcut.WindowStyle = 7",
        "$shortcut.Description = 'ToSnip paste'",
        "$shortcut.Save()",
        "$oldShortcut = Join-Path $startup 'Spaceur paste.lnk'",
        "if (Test-Path -LiteralPath $oldShortcut) { Remove-Item -LiteralPath $oldShortcut -Force }",
        "$command = '\"' + $exe + '\" ' + $arguments",
        "$started = $false",
        "try {",
        "    $result = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{ CommandLine = $command; CurrentDirectory = $dir }",
        "    if ($result.ReturnValue -eq 0) { $started = $true }",
        "} catch {}",
        "if (-not $started) {",
        "    $startInfo = New-Object System.Diagnostics.ProcessStartInfo",
        "    $startInfo.FileName = $exe",
        "    $startInfo.Arguments = $arguments",
        "    $startInfo.WorkingDirectory = $dir",
        "    $startInfo.UseShellExecute = $true",
        "    $startInfo.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Hidden",
        "    [System.Diagnostics.Process]::Start($startInfo) | Out-Null",
        "}"
    ],
    "post_uninstall": [
        "if ($cmd -ne 'uninstall') { return }",
        "$localDir = Join-Path $env:LOCALAPPDATA 'ToSnip'",
        "$oldDir = Join-Path $env:LOCALAPPDATA 'Spaceur'",
        "if (Test-Path -LiteralPath $localDir) { Remove-Item -LiteralPath $localDir -Recurse -Force }",
        "if (Test-Path -LiteralPath $oldDir) { Remove-Item -LiteralPath $oldDir -Recurse -Force }",
        "$drive = $env:SystemDrive",
        "if (-not $drive) { $drive = 'C:' }",
        "function Remove-MarkedPictures($store, $markName, $markValue) {",
        "    $mark = Join-Path $store $markName",
        "    if (-not (Test-Path -LiteralPath $mark)) { return }",
        "    $text = Get-Content -LiteralPath $mark -Raw -ErrorAction SilentlyContinue",
        "    if (-not ($text -and $text.Trim() -eq $markValue)) { return }",
        "    Get-ChildItem -LiteralPath $store -Filter '*.jpg' -File | ForEach-Object {",
        "        if ($_.Name -match '^[a-z0-9]{6}\\.jpg$') { Remove-Item -LiteralPath $_.FullName -Force }",
        "    }",
        "    Remove-Item -LiteralPath $mark -Force",
        "    $left = @(Get-ChildItem -LiteralPath $store -Force)",
        "    if ($left.Length -eq 0) { Remove-Item -LiteralPath $store -Force }",
        "}",
        "Remove-MarkedPictures ($drive + '\\ToSnip') 'tosnip.txt' 'tosnip'",
        "Remove-MarkedPictures ($drive + '\\Spaceur') 'spaceur.txt' 'spaceur'"
    ]
}
